@echo off
chcp 65001 >nul
REM Проверка деплоя БЕЗ SSH подключения

echo ========================================
echo Проверка деплоя (без SSH)
echo ========================================
echo.

echo [1/3] Проверка доступности сайта...
curl -s -o nul -w "HTTP Status: %{http_code}\n" https://newava.pro/
if %ERRORLEVEL% EQU 0 (
    echo [OK] Сайт доступен и отвечает!
) else (
    echo [ERROR] Сайт недоступен
)
echo.

echo [2/3] Проверка локального коммита...
echo Локальная ветка: avatar
git log -1 --oneline
echo.

echo [3/3] Проверка через веб-интерфейс...
echo.
echo Откройте в браузере: https://newava.pro/
echo.
echo Если сайт открывается и показывает ваше приложение - деплой успешен!
echo.

echo ========================================
echo ВАЖНО: Если пароль не подходит для SSH
echo ========================================
echo.
echo Возможные причины:
echo 1. Пароль мог измениться на сервере
echo 2. SSH настроен только на ключи
echo 3. Проблемы с кодировкой при вводе
echo.
echo РЕШЕНИЕ: Используйте GitHub Actions для автоматического деплоя
echo или обратитесь к администратору сервера для проверки пароля.
echo.

pause

